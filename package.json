{
  "name": "ib-toolkit",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "packages/*",
    "packages/standards/template"
  ],
  "scripts": {
    "check": "turbo run typecheck test lint:arch lint ib:check && biome check .",
    "dev:template": "turbo run dev --filter=@fieldtripagency/template...",
    "typecheck": "turbo run typecheck",
    "build:packages": "turbo run build --filter=./packages/*",
    "test": "turbo run test",
    "lint": "biome check . && turbo run lint",
    "lint:fix": "biome check . --write && bun --filter @fieldtripagency/template lint:fix",
    "storybook": "bun --filter @fieldtripagency/ui storybook",
    "build-storybook": "turbo run build-storybook",
    "pack:local": "bun run build:packages && bun scripts/pack-local.ts",
    "sync": "bun run build:packages && bun scripts/sync-local.ts",
    "release": "bun run build:packages && bun scripts/publish.ts",
    "eval:ui": "bun evals/ui/run.ts",
    "test:eval": "bun test evals/ui",
    "visual": "bun scripts/visual.ts",
    "visual:approve": "bun scripts/visual.ts --approve",
    "align": "bun scripts/align.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.3.5",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "playwright": "1.65.1",
    "pngjs": "^7.0.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
